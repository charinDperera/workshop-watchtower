---
/**
 * Switches between the night and day themes and remembers the choice. Until the user
 * chooses, the theme follows `prefers-color-scheme`. Needs JavaScript, so it is hidden
 * without it (the system preference still applies).
 */
---

<button
  type="button"
  class="js-only theme-toggle inline-flex size-8 items-center sm:size-9 justify-center rounded-full border border-line-strong text-ink-muted transition-colors duration-(--duration-fast) hover:border-gold hover:text-gold"
  data-theme-toggle
  aria-label="Switch theme"
>
  <svg
    class="theme-icon-sun size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2m0 15v2M2.5 12h2m15 0h2M5.3 5.3l1.4 1.4m10.6 10.6 1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
  </svg>
  <svg
    class="theme-icon-moon size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z"></path>
    <path d="M16.5 3.5v3m-1.5-1.5h3"></path>
  </svg>
</button>

<style>
  /* Show the icon of the theme the button switches to. */
  .theme-toggle[data-current='dark'] .theme-icon-moon,
  .theme-toggle[data-current='light'] .theme-icon-sun,
  .theme-toggle:not([data-current]) .theme-icon-moon {
    display: none;
  }
</style>

<script>
  const KEY = 'watchtower-theme';
  type Theme = 'light' | 'dark';
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: light)');

  function current(): Theme {
    const chosen = root.getAttribute('data-theme');
    if (chosen === 'light' || chosen === 'dark') return chosen;
    return media.matches ? 'light' : 'dark';
  }

  function render(button: HTMLElement): void {
    const theme = current();
    button.dataset.current = theme;
    button.setAttribute(
      'aria-label',
      theme === 'dark' ? 'Switch to the light theme' : 'Switch to the dark theme',
    );
    button.title = theme === 'dark' ? 'Day theme' : 'Night theme';
  }

  for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
    render(button);
    button.addEventListener('click', () => {
      const next: Theme = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        window.localStorage.setItem(KEY, next);
      } catch {
        // Storage blocked: the choice lasts for this page only.
      }
      render(button);
    });
    // Follow the system while the user has not chosen.
    media.addEventListener('change', () => render(button));
  }
</script>

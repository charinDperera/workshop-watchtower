---
/**
 * A quiet field of stars behind the header. Deterministic (seeded), so it never shifts
 * between renders. Purely decorative.
 */
import { seeded } from '../ui/sigil';

interface Props {
  seed?: number;
  count?: number;
}
const { seed = 1440, count = 70 } = Astro.props;

const WIDTH = 1440;
const HEIGHT = 160;
const random = seeded(seed);
const round = (n: number) => Math.round(n * 10) / 10;
const stars = Array.from({ length: count }, () => ({
  x: round(random() * WIDTH),
  y: round(random() * HEIGHT),
  r: round(0.4 + random() * random() * 1.3),
  o: round(0.25 + random() * 0.6),
}));
// A few bright stars get a faint cross of light.
const bright = stars.filter((s) => s.r > 1.2).slice(0, 4);
---

<svg
  class="pointer-events-none absolute inset-0 -z-10 h-full w-full mask-b-from-20% mask-b-to-60% text-star"
  viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {stars.map((s) => (
    <circle cx={s.x} cy={s.y} r={s.r} fill="currentColor" opacity={s.o} />
  ))}
  {bright.map((s) => (
    <path
      d={`M${s.x - 6} ${s.y}H${s.x + 6}M${s.x} ${s.y - 6}V${s.y + 6}`}
      stroke="currentColor"
      stroke-width="0.5"
      opacity="0.35"
    />
  ))}
</svg>

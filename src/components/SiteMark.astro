---
/** The wordmark: a watchtower beneath a star, with the name in Lato Black capitals. */
interface Props {
  rootName?: string | null;
}
const { rootName = null } = Astro.props;
---

<a
  href="/"
  class="group flex items-center gap-2 text-ink sm:gap-3 no-underline"
  aria-label="The Watchtower, overview"
>
  <svg
    class="size-8 shrink-0 text-gold sm:size-9 transition-colors duration-(--duration-fast) group-hover:text-gold-strong"
    viewBox="0 0 40 40"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="20" cy="20" r="18.5" stroke-opacity="0.45"></circle>
    <path
      d="m20 4.5 1.1 2.6 2.6 1.1-2.6 1.1L20 12l-1.1-2.7-2.6-1.1 2.6-1.1Z"
      fill="currentColor"
    ></path>
    <path d="M15.5 33V19l4.5-4 4.5 4v14"></path>
    <path d="M13 33h14M17.5 23h5M17.5 27.5h5"></path>
    <path d="M19 19.5h2v2h-2z" fill="currentColor"></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-md font-black tracking-caps whitespace-nowrap uppercase sm:text-lg">
      The Watchtower
    </span>
    {rootName && (
      <span class="eyebrow mt-1 hidden xs:block" aria-hidden="true">
        Over {rootName}
      </span>
    )}
  </span>
</a>

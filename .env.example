# =============================================================================
# The Watchtower: environment variables
# Copy to .env and fill in real values. Never commit .env.
# Every variable is optional: with none set, the Watchtower runs on the host on
# 127.0.0.1:4321, reads the workstation two folders above the app and logs to
# <WATCHTOWER_ROOT>/limforia/logs/watchtower. Any invalid value stops the server at
# startup with a message naming the variable (never its value).
# Validated by scripts/server-env.mjs; read through src/server/config/env.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# [optional] Runtime environment: development | test | production
#   default: development (scripts/start.mjs, i.e. `pnpm start`, defaults to production)
NODE_ENV=development
# [optional] Bind address, an IP literal. Honoured ONLY in container mode
#   (WATCHTOWER_CONTAINER=1), where it defaults to 0.0.0.0. On the host the server
#   always binds to 127.0.0.1, whatever this says.
HOST=
# [optional] Port the server listens on, 1-65535 (default: 4321). The Host-header guard
#   admits only localhost:4321 and 127.0.0.1:4321 unless WATCHTOWER_ALLOWED_HOSTS adds more.
PORT=4321
# [optional] The workstation folder to show, read-only (absolute, or relative to the
#   current folder). Must exist. default: the folder two levels above the app (F:\Projects)
WATCHTOWER_ROOT=
# [optional] 1 = container mode (honour HOST, allow WATCHTOWER_TRUSTED_CLIENTS,
#   mark mounted git repos safe through env). 0 or empty = host mode (default).
WATCHTOWER_CONTAINER=0
# [optional] Container mode only: comma-separated IPs or CIDRs admitted besides loopback,
#   e.g. the Docker network gateway. format: 172.30.43.1,192.168.65.0/24 (default: none)
WATCHTOWER_TRUSTED_CLIENTS=
# [optional] Extra Host header values the guard admits, comma-separated host:port.
#   Needed when the published port is not 4321. format: localhost:8080,127.0.0.1:8080
WATCHTOWER_ALLOWED_HOSTS=
# [optional] Detect file changes by polling every N ms (250-60000) instead of fs.watch.
#   Use in a container on a Windows bind mount, where file events do not arrive.
#   default: empty (use fs.watch)
WATCHTOWER_POLL_MS=

# [optional] The public origin users open when the app runs behind a gateway (nginx),
#   e.g. https://dev-watchtower.workshop.io. Strict: http or https, a host and an optional
#   non-default port; no path (not even a trailing /), query or credentials.
#   Its host is admitted as a Host header, and client error reports may come from it.
#   X-Forwarded-* headers are never trusted. default: empty (no gateway)
WATCHTOWER_PUBLIC_ORIGIN=

# [optional] Build folder: where `astro build` writes and `pnpm start` serves from
#   (<dir>/server/entry.mjs, <dir>/client/). Relative paths resolve against the app folder;
#   set the same value for the build and the start. Must not be the app folder or above it.
#   Lets a separate build (e.g. e2e: .local/peter/e2e/dist) never share dist/. default: dist
WATCHTOWER_DIST_DIR=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# [optional] fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
# [optional] Folder for log files: <LOG_DIR>/bff/YYYY-MM-DD.jsonl and
#   <LOG_DIR>/client/YYYY-MM-DD.jsonl (absolute, or relative to the current folder).
#   default: <WATCHTOWER_ROOT>/limforia/logs/watchtower. In Docker: /var/log/app.
LOG_DIR=

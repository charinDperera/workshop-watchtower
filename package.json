{
  "name": "watchtower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Watchtower: a local live dashboard of the workstation.",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./scripts/start.mjs",
    "preview": "astro preview",
    "check": "pnpm run check:astro && pnpm run check:svelte",
    "check:astro": "astro check",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@astrojs/node": "11.1.8",
    "@astrojs/svelte": "9.1.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "astro": "7.4.0",
    "marked": "18.1.1",
    "pino": "10.4.0",
    "sanitize-html": "2.18.1",
    "svelte": "5.57.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
